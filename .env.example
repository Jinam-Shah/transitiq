# Copy this file to .env and fill in values. Never commit .env.

# --- LocalStack (free Hobby plan, non-commercial; no credit card) ---
# Get it at https://app.localstack.cloud -> Auth Tokens. Required since LocalStack 2026.03.
LOCALSTACK_AUTH_TOKEN=

# --- Local Postgres (Docker) ---
POSTGRES_USER=transitiq
POSTGRES_PASSWORD=transitiq_local_only
POSTGRES_DB=transitiq
# Host port. 5433 avoids clashing with a Postgres already installed on Windows.
POSTGRES_HOST_PORT=5433

# --- Airflow (local Docker) ---
AIRFLOW_HOST_PORT=8080
# Linux/macOS: set to your `id -u`. On Windows Docker Desktop, leave 50000.
AIRFLOW_UID=50000

# --- Fake AWS credentials for LocalStack only (NOT real AWS) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_ENDPOINT=http://localhost:4566

# --- dbt / DuckDB memory (D-025). Lower these if dbt_build runs out of memory ---
TRANSITIQ_DUCKDB_MEMORY=2GB
TRANSITIQ_DBT_THREADS=1
TRANSITIQ_DUCKDB_THREADS=4
# LightGBM threads for transitiq-ml train
TRANSITIQ_ML_THREADS=4

# --- Filled in later phases ---
MBTA_API_KEY=
# Neon free tier (optional). Copy the connection string from the Neon console, e.g.
# postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=
GEMINI_API_KEY=
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
